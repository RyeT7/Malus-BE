APP_ENV=local
LOG_LEVEL=debug
AUTH_DISABLED=true
AUTH_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_AUDIENCE=<api-client-id>
AUTH_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys

MSSQL_SA_PASSWORD=<sa-password: 8+ chars with upper, lower, digit and symbol, no semicolons>
SQL_DSN=server=<host>;port=<port>;user id=<user>;password=<password>;database=<database>;encrypt=true;TrustServerCertificate=true

BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=<http-or-https>;AccountName=<account-name>;AccountKey=<account-key>;BlobEndpoint=<blob-endpoint>;
BLOB_PUBLIC_ENDPOINT=<browser-facing-blob-endpoint>

COSMOS_ENDPOINT=<cosmos-endpoint>
COSMOS_KEY=<cosmos-key>
