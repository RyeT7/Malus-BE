APP_ENV=local
LOG_LEVEL=debug
AUTH_DISABLED=true
AUTH_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_AUDIENCE=<api-client-id>
AUTH_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
AUTH_ADMIN_ROLE=admin

MSSQL_SA_PASSWORD=<8+ chars with upper, lower, digit and symbol, no semicolons>
SQL_DSN=server=localhost;port=14330;user id=sa;password=<same as MSSQL_SA_PASSWORD>;database=malus_content;encrypt=true;TrustServerCertificate=true

COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_DATABASE=malus
COSMOS_QUESTIONS_CONTAINER=questions
COSMOS_KEY=
