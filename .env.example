APP_ENV=local
LOG_LEVEL=info
PORT=8080

AUTH_DISABLED=true
AUTH_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_AUDIENCE=<api-client-id>
AUTH_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
AUTH_ADMIN_ROLE=admin

CONTENT_URL=http://localhost:8081
INTERACTION_URL=http://localhost:8082
REALTIME_URL=http://localhost:8083
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HEADERS=false
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
RATE_LIMIT_WRITE_RPS=5
RATE_LIMIT_WRITE_BURST=10

MSSQL_SA_PASSWORD=<sa-password: 8+ chars with upper, lower, digit and symbol, no semicolons>
SQL_DSN=server=<host>;port=<port>;user id=<user>;password=<password>;database=<database>;encrypt=true;TrustServerCertificate=true

BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=<http-or-https>;AccountName=<account-name>;AccountKey=<account-key>;BlobEndpoint=<blob-endpoint>;
BLOB_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
BLOB_CONTAINER=attachments
BLOB_PUBLIC_ENDPOINT=<browser-facing-blob-endpoint>
BLOB_CORS_ORIGINS=http://localhost:5173

COSMOS_ENDPOINT=<cosmos-endpoint>
COSMOS_KEY=<cosmos-key>
COSMOS_DATABASE=malus
COSMOS_QUESTIONS_CONTAINER=questions
COSMOS_SESSIONS_CONTAINER=sessions

WEBPUBSUB_ENDPOINT=https://<web-pubsub-name>.webpubsub.azure.com
WEBPUBSUB_HUB=malus
WEBPUBSUB_ACCESS_KEY=<web-pubsub-access-key>
LIVE_STREAM_URL=/v1/live/stream

MALUS_TEST_SQL_DSN=server=<host>;port=<port>;user id=<user>;password=<password>;database=<database>_test;encrypt=true;TrustServerCertificate=true
